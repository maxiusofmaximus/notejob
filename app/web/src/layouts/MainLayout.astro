---
import "../styles/global.scss";

interface Props {
  title?: string;
  description?: string;
  page?: "landing" | "app" | "confirm";
}

const {
  title = "NoteJob",
  description = "Research-driven tasks, projects, and learning resources.",
  page = "landing"
} = Astro.props;
---
<!doctype html>
<html lang="en" data-page={page}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        const raw = localStorage.getItem("notejob.site.custom.v1");
        if (raw) {
          const cfg = JSON.parse(raw);
          if (cfg?.theme?.brand) document.documentElement.style.setProperty("--brand", cfg.theme.brand);
          if (cfg?.theme?.accent) document.documentElement.style.setProperty("--accent", cfg.theme.accent);
          if (cfg?.theme?.bg) document.documentElement.style.setProperty("--bg-1", cfg.theme.bg);
        }
      } catch {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=IBM+Plex+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
