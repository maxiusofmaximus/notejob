---
import MainLayout from "../layouts/MainLayout.astro";
---
<MainLayout
  title="NoteJob · Workspace"
  description="Manage tasks, projects, resources, and AI planning in one dashboard."
  page="app"
>
  <header class="site-header">
    <div class="app-shell site-header__inner">
      <a class="brand" href="/">
        <img src="/brand/notejob-logo.svg" alt="NoteJob logo" class="brand__logo" />
        <div>
          <p class="brand__title">NoteJob</p>
          <p class="brand__sub" data-i18n="workspace_sub">Execution dashboard for tasks and knowledge.</p>
        </div>
      </a>
      <div class="header-actions">
        <a class="btn btn--ghost" href="/docs">Docs</a>
        <button class="btn btn--ghost" id="openLoginBtn" type="button" data-i18n="login">Login</button>
        <button class="btn btn--primary" id="openSignupBtn" type="button" data-i18n="signup">Signup</button>
        <button class="btn" id="signOutBtn" type="button" data-i18n="logout">Logout</button>
      </div>
    </div>
  </header>

  <main class="app-shell dashboard">
    <aside class="sidebar">
      <h2 data-i18n="account">Account</h2>
      <p class="muted" id="accountEmail">Not authenticated</p>
      <div>
        <p class="muted" data-i18n="system_health">System status</p>
        <div class="chip-row" id="mcpStatus"></div>
      </div>
      <div>
        <button class="btn btn--ghost" id="runMcpChecksBtn" type="button" data-i18n="run_checks">Refresh status</button>
      </div>
      <div>
        <p class="muted" data-i18n="quick_actions">Quick actions</p>
        <div class="row">
          <button class="btn btn--ghost" id="newTaskBtn" type="button" data-i18n="new_task">New task</button>
          <button class="btn btn--ghost" id="newProjectBtn" type="button" data-i18n="new_project">New project</button>
        </div>
      </div>
      <p class="status-line" id="localeLine">Locale: auto</p>
    </aside>

    <section class="content-card">
      <h2 data-i18n="overview">Overview</h2>
      <p class="muted" id="lastActivity">No activity yet.</p>
      <div class="metrics">
        <article class="metric"><span data-i18n="tasks">Tasks</span><strong id="sumTasks">0</strong></article>
        <article class="metric"><span data-i18n="projects">Projects</span><strong id="sumProjects">0</strong></article>
        <article class="metric"><span data-i18n="resources">Resources</span><strong id="sumResources">0</strong></article>
        <article class="metric"><span data-i18n="overdue">Overdue</span><strong id="sumOverdue">0</strong></article>
      </div>

      <div class="cards-grid" id="itemsGrid"></div>

      <div style="margin-top:0.95rem;">
        <h2 data-i18n="ai_planner">AI Planner</h2>
        <p class="muted" data-i18n="ai_hint">Ask for a weekly plan, project breakdown, or next-step checklist.</p>
        <div class="form-field">
          <textarea id="chatInput" rows="3" placeholder="Plan tasks from 2026-03-01 to 2026-03-20 for Unreal prototype"></textarea>
        </div>
        <div class="row">
          <button class="btn btn--primary" id="chatSendBtn" type="button" data-i18n="send">Send</button>
        </div>
      </div>

      <div style="margin-top:1.25rem;">
        <h2>Private Vault</h2>
        <p class="muted">Store sensitive snippets with tags. Data is encrypted in your browser using your vault passphrase.</p>
        <div class="vault-row">
          <label class="form-field">Vault passphrase
            <input id="vaultPassphrase" type="password" autocomplete="new-password" />
          </label>
          <label class="form-field">Entry label
            <input id="vaultLabel" type="text" autocomplete="off" />
          </label>
          <label class="form-field">Tags (comma)
            <input id="vaultTags" type="text" placeholder="email,temp,game" autocomplete="off" />
          </label>
        </div>
        <div class="form-field" style="margin-top:0.45rem;">
          Secret content
          <textarea id="vaultSecret" rows="3" placeholder="Password, token, or secure note"></textarea>
        </div>
        <div class="row">
          <button class="btn btn--primary" id="vaultSaveBtn" type="button">Save encrypted</button>
          <button class="btn btn--ghost" id="vaultUnlockBtn" type="button">Unlock vault</button>
        </div>
        <div class="vault-grid" id="vaultGrid"></div>
      </div>
    </section>
  </main>

  <button class="settings-fab" id="settingsFab" type="button" aria-label="Open settings">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M10.3 2.6a1 1 0 0 1 1.4 0l1 1a1 1 0 0 0 1 .25l1.4-.4a1 1 0 0 1 1.2.7l.5 1.3a1 1 0 0 0 .8.65l1.4.2a1 1 0 0 1 .84 1.1l-.15 1.4a1 1 0 0 0 .42.94l1.15.85a1 1 0 0 1 .26 1.4l-.8 1.15a1 1 0 0 0-.08 1.03l.65 1.25a1 1 0 0 1-.43 1.35l-1.25.64a1 1 0 0 0-.53.88v1.4a1 1 0 0 1-1 1h-1.4a1 1 0 0 0-.88.53l-.64 1.25a1 1 0 0 1-1.35.43l-1.25-.65a1 1 0 0 0-1.03.08l-1.15.8a1 1 0 0 1-1.4-.26l-.85-1.15a1 1 0 0 0-.94-.42l-1.4.15a1 1 0 0 1-1.1-.84l-.2-1.4a1 1 0 0 0-.65-.8l-1.3-.5a1 1 0 0 1-.7-1.2l.4-1.4a1 1 0 0 0-.25-1l-1-1a1 1 0 0 1 0-1.4l1-1a1 1 0 0 0 .25-1l-.4-1.4a1 1 0 0 1 .7-1.2l1.3-.5a1 1 0 0 0 .65-.8l.2-1.4a1 1 0 0 1 1.1-.84l1.4.15a1 1 0 0 0 .94-.42l.85-1.15z" stroke="currentColor" stroke-width="1.4"/>
      <circle cx="12" cy="12" r="3.4" stroke="currentColor" stroke-width="1.4"/>
    </svg>
  </button>

  <dialog class="modal" id="authModal">
    <form method="dialog" class="modal-card">
      <h3 id="authTitle">Access</h3>
      <label class="form-field">
        Email
        <input id="authEmail" type="email" autocomplete="email" />
      </label>
      <label class="form-field">
        Password
        <input id="authPassword" type="password" autocomplete="current-password" />
      </label>
      <div class="row">
        <button class="btn btn--primary" type="button" id="submitSignupBtn">Create account</button>
        <button class="btn btn--ghost" type="button" id="submitLoginBtn">Login</button>
        <button class="btn" type="button" id="closeAuthModalBtn">Close</button>
      </div>
    </form>
  </dialog>

  <dialog class="modal" id="creatorModal">
    <form method="dialog" class="modal-card">
      <h3 id="creatorTitle">New item</h3>
      <label class="form-field">Title <input id="newTitle" type="text" /></label>
      <label class="form-field">Type
        <select id="newKind">
          <option value="task">Task</option>
          <option value="project">Project</option>
        </select>
      </label>
      <label class="form-field">Status
        <select id="newStatus">
          <option value="inbox">Inbox</option>
          <option value="researching">Researching</option>
          <option value="ready">Ready</option>
          <option value="done">Done</option>
        </select>
      </label>
      <label class="form-field">Start date <input id="newStartDate" type="date" /></label>
      <label class="form-field">Due date <input id="newDueDate" type="date" /></label>
      <label class="form-field">Done subtasks <input id="newDoneSubtasks" type="number" min="0" value="0" /></label>
      <label class="form-field">Total subtasks <input id="newTotalSubtasks" type="number" min="1" value="1" /></label>
      <label class="form-field">Resources (comma) <input id="newResources" type="text" /></label>
      <label class="form-field">Summary <textarea id="newSummary" rows="3"></textarea></label>
      <div class="row">
        <button class="btn btn--primary" id="saveItemBtn" type="button">Save</button>
        <button class="btn" id="closeCreatorBtn" type="button">Close</button>
      </div>
    </form>
  </dialog>

  <dialog class="modal" id="settingsModal">
    <form method="dialog" class="modal-card">
      <h3>Settings</h3>
      <label class="form-field">AI Base URL
        <input id="settingsAiBaseUrl" type="text" />
      </label>
      <label class="form-field">AI Model
        <input id="settingsAiModel" type="text" />
      </label>
      <label class="form-field">AI API Key
        <input id="settingsAiKey" type="password" />
      </label>
      <label class="form-field">Language
        <select id="settingsLanguage">
          <option value="auto">Auto</option>
          <option value="en">English</option>
          <option value="es">Español</option>
        </select>
      </label>
      <label class="form-field">Start week on
        <select id="settingsWeekStart">
          <option value="monday">Monday</option>
          <option value="sunday">Sunday</option>
        </select>
      </label>
      <label class="form-field">Compact cards
        <select id="settingsCompactCards">
          <option value="off">Off</option>
          <option value="on">On</option>
        </select>
      </label>
      <label class="form-field">Weekly summary email
        <select id="settingsWeeklyDigest">
          <option value="on">On</option>
          <option value="off">Off</option>
        </select>
      </label>
      <div class="row">
        <button class="btn btn--primary" id="saveSettingsBtn" type="button">Save</button>
        <button class="btn" id="closeSettingsBtn" type="button">Close</button>
      </div>
    </form>
  </dialog>

  <script>
    import "../scripts/app.ts";
  </script>
</MainLayout>
