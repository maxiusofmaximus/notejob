---
import MainLayout from "../layouts/MainLayout.astro";
---
<MainLayout
  title="NoteJob · Email Confirmed"
  description="Your email has been verified. Continue to your workspace."
  page="confirm"
>
  <main class="app-shell landing-main" style="min-height:70vh;align-content:center;">
    <section class="panel hero-copy">
      <span class="kicker">Account Security</span>
      <h1 style="font-size:clamp(1.65rem,4vw,2.45rem);max-width:18ch;">Your email is now confirmed.</h1>
      <p>You can return to your workspace and continue planning tasks, projects, and reusable learning resources.</p>
      <div class="hero-ctas">
        <a class="btn btn--primary" href="/app">Go to workspace</a>
        <a class="btn" href="/">Back to home</a>
      </div>
    </section>
  </main>
</MainLayout>
